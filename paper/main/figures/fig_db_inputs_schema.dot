    <TR><TD ALIGN="LEFT" PORT="proc_fac">proc_fac</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">double</FONT></TD><TD ALIGN="LEFT" PORT="proc_fac_e"> </TD></TR>
    <TR><TD ALIGN="LEFT" PORT="proc_cap">proc_cap</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">double</FONT></TD><TD ALIGN="LEFT" PORT="proc_cap_e"> </TD></TR>
