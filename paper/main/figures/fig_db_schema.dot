    <TR><TD ALIGN="LEFT" PORT="production_oil_t">production_oil_t</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">double</FONT></TD><TD ALIGN="LEFT" PORT="production_oil_t_e"> </TD></TR>
    <TR><TD ALIGN="LEFT" PORT="production_cake_t">production_cake_t</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">double</FONT></TD><TD ALIGN="LEFT" PORT="production_cake_t_e"> </TD></TR>
    <TR><TD ALIGN="LEFT" PORT="year">year</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">int</FONT></TD><TD ALIGN="LEFT" PORT="year_e"><FONT COLOR="#777777">pk</FONT></TD></TR>
    </TABLE>>];
  domestic_use [color="#3d7337", label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
    <TR><TD COLSPAN="3" BGCOLOR="#dcebd7" ALIGN="LEFT"><B>domestic_use</B>  <FONT POINT-SIZE="8" COLOR="#555555">545,446 rows</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="co_mun">co_mun</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">int</FONT></TD><TD ALIGN="LEFT" PORT="co_mun_e"><FONT COLOR="#777777">pk fk</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="product">product</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="product_e"><FONT COLOR="#777777">pk fk</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="use_category">use_category</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="use_category_e"><FONT COLOR="#777777">pk</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="tonnes">tonnes</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">double</FONT></TD><TD ALIGN="LEFT" PORT="tonnes_e"> </TD></TR>
    <TR><TD ALIGN="LEFT" PORT="year">year</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">int</FONT></TD><TD ALIGN="LEFT" PORT="year_e"><FONT COLOR="#777777">pk</FONT></TD></TR>
    </TABLE>>];
  trade [color="#3d7337", label=<
