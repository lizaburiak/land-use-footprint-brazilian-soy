    <TR><TD COLSPAN="3" BGCOLOR="#dcebd7" ALIGN="LEFT"><B>trade</B>  <FONT POINT-SIZE="8" COLOR="#555555">45,345 rows</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="co_mun">co_mun</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">int</FONT></TD><TD ALIGN="LEFT" PORT="co_mun_e"><FONT COLOR="#777777">pk fk</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="product">product</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="product_e"><FONT COLOR="#777777">pk fk</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="flow">flow</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="flow_e"><FONT COLOR="#777777">pk</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="partner_iso3">partner_iso3</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="partner_iso3_e"><FONT COLOR="#777777">pk fk</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="hs4">hs4</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">int</FONT></TD><TD ALIGN="LEFT" PORT="hs4_e"><FONT COLOR="#777777">pk</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="tonnes">tonnes</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">double</FONT></TD><TD ALIGN="LEFT" PORT="tonnes_e"> </TD></TR>
    <TR><TD ALIGN="LEFT" PORT="value_usd">value_usd</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">double</FONT></TD><TD ALIGN="LEFT" PORT="value_usd_e"> </TD></TR>
    <TR><TD ALIGN="LEFT" PORT="year">year</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">int</FONT></TD><TD ALIGN="LEFT" PORT="year_e"><FONT COLOR="#777777">pk</FONT></TD></TR>
    </TABLE>>];
  }
  subgraph cluster_2 {
    label="Transport & export attribution (step 08)"; fontsize=11; fontcolor="#b26a12"; color="#b26a12"; style=dashed; margin=10;
  export_attribution [color="#b26a12", label=<
