  dim_municipality:co_mun_e:e -> footprint_country:co_mun:w [arrowtail=teetee, arrowhead=crowodot];
  dim_country:iso3c_e:e -> footprint_country:consumer_code:w [arrowtail=teetee, arrowhead=crowodot];
