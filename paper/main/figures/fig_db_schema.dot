    <TR><TD ALIGN="LEFT" PORT="production_bean_t">production_bean_t</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">double</FONT></TD><TD ALIGN="LEFT" PORT="production_bean_t_e"> </TD></TR>
