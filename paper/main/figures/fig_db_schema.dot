digraph soyprint_db {
  graph [rankdir=LR, splines=spline, nodesep=0.45, ranksep=1.1, newrank=true, compound=true, fontname="Helvetica", fontsize=11, labelloc=t, label="SOYPRINT database (soyprint.duckdb). Fact tables cover 2000–2022 and are hive-partitioned by year in the Parquet layer."];
  node [shape=plain, fontname="Helvetica", fontsize=9];
  edge [color="#31538f", penwidth=0.9, dir=both, arrowtail=crowodot, arrowhead=teetee, arrowsize=0.7];
  subgraph cluster_0 {
    label="Dimensions"; fontsize=11; fontcolor="#31538f"; color="#31538f"; style=dashed; margin=10;
  dim_municipality [color="#31538f", label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
    <TR><TD COLSPAN="3" BGCOLOR="#dbe6f4" ALIGN="LEFT"><B>dim_municipality</B>  <FONT POINT-SIZE="8" COLOR="#555555">5,572 rows</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="co_mun">co_mun</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">int</FONT></TD><TD ALIGN="LEFT" PORT="co_mun_e"><FONT COLOR="#777777">pk</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="nm_mun">nm_mun</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="nm_mun_e"> </TD></TR>
    <TR><TD ALIGN="LEFT" PORT="co_state">co_state</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">int</FONT></TD><TD ALIGN="LEFT" PORT="co_state_e"> </TD></TR>
    <TR><TD ALIGN="LEFT" PORT="nm_state">nm_state</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="nm_state_e"> </TD></TR>
    <TR><TD ALIGN="LEFT" PORT="lon">lon</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">double</FONT></TD><TD ALIGN="LEFT" PORT="lon_e"> </TD></TR>
    <TR><TD ALIGN="LEFT" PORT="lat">lat</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">double</FONT></TD><TD ALIGN="LEFT" PORT="lat_e"> </TD></TR>
    <TR><TD ALIGN="LEFT" PORT="biome">biome</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="biome_e"> </TD></TR>
    <TR><TD ALIGN="LEFT" PORT="matopiba">matopiba</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">bool</FONT></TD><TD ALIGN="LEFT" PORT="matopiba_e"> </TD></TR>
    </TABLE>>];
  dim_soy_product [color="#31538f", label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
    <TR><TD COLSPAN="3" BGCOLOR="#dbe6f4" ALIGN="LEFT"><B>dim_soy_product</B>  <FONT POINT-SIZE="8" COLOR="#555555">3 rows</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="product">product</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="product_e"><FONT COLOR="#777777">pk</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="hs4">hs4</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">int</FONT></TD><TD ALIGN="LEFT" PORT="hs4_e"> </TD></TR>
    <TR><TD ALIGN="LEFT" PORT="fabio_item_code">fabio_item_code</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">int</FONT></TD><TD ALIGN="LEFT" PORT="fabio_item_code_e"> </TD></TR>
    <TR><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="description_e"> </TD></TR>
    </TABLE>>];
  dim_commodity [color="#31538f", label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
    <TR><TD COLSPAN="3" BGCOLOR="#dbe6f4" ALIGN="LEFT"><B>dim_commodity</B>  <FONT POINT-SIZE="8" COLOR="#555555">140 rows</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="comm_code">comm_code</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="comm_code_e"><FONT COLOR="#777777">pk</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="item_code">item_code</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">int</FONT></TD><TD ALIGN="LEFT" PORT="item_code_e"> </TD></TR>
    <TR><TD ALIGN="LEFT" PORT="item">item</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="item_e"> </TD></TR>
    <TR><TD ALIGN="LEFT" PORT="comm_group">comm_group</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="comm_group_e"> </TD></TR>
    <TR><TD ALIGN="LEFT" PORT="group">group</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="group_e"> </TD></TR>
    <TR><TD ALIGN="LEFT" PORT="enduse_bucket">enduse_bucket</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="enduse_bucket_e"> </TD></TR>
    </TABLE>>];
  dim_country [color="#31538f", label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
    <TR><TD COLSPAN="3" BGCOLOR="#dbe6f4" ALIGN="LEFT"><B>dim_country</B>  <FONT POINT-SIZE="8" COLOR="#555555">267 rows</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="iso3c">iso3c</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="iso3c_e"><FONT COLOR="#777777">pk</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="name_e"> </TD></TR>
    <TR><TD ALIGN="LEFT" PORT="continent">continent</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="continent_e"> </TD></TR>
    <TR><TD ALIGN="LEFT" PORT="region">region</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="region_e"> </TD></TR>
    <TR><TD ALIGN="LEFT" PORT="eu27">eu27</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">bool</FONT></TD><TD ALIGN="LEFT" PORT="eu27_e"> </TD></TR>
    </TABLE>>];
  }
  subgraph cluster_1 {
    label="Supply, use & trade (pipeline step 05)"; fontsize=11; fontcolor="#3d7337"; color="#3d7337"; style=dashed; margin=10;
  production [color="#3d7337", label=<
