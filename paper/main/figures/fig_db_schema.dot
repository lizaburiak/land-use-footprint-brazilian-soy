    <TR><TD ALIGN="LEFT" PORT="year">year</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">int</FONT></TD><TD ALIGN="LEFT" PORT="year_e"><FONT COLOR="#777777">pk</FONT></TD></TR>
    </TABLE>>];
  }
  subgraph cluster_3 {
    label="Consumption footprints (step 20)"; fontsize=11; fontcolor="#a03232"; color="#a03232"; style=dashed; margin=10;
  footprint_country [color="#a03232", label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
    <TR><TD COLSPAN="3" BGCOLOR="#f4d7d7" ALIGN="LEFT"><B>footprint_country</B>  <FONT POINT-SIZE="8" COLOR="#555555">10,548,217 rows</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="co_mun">co_mun</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">int</FONT></TD><TD ALIGN="LEFT" PORT="co_mun_e"><FONT COLOR="#777777">pk fk</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="consumer_code">consumer_code</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="consumer_code_e"><FONT COLOR="#777777">pk fk</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="demand">demand</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="demand_e"><FONT COLOR="#777777">pk</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="hectares">hectares</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">double</FONT></TD><TD ALIGN="LEFT" PORT="hectares_e"> </TD></TR>
