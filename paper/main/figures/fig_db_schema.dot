    <TR><TD ALIGN="LEFT" PORT="method">method</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="method_e"><FONT COLOR="#777777">pk</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="product">product</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="product_e"><FONT COLOR="#777777">pk fk</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="co_mun">co_mun</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">int</FONT></TD><TD ALIGN="LEFT" PORT="co_mun_e"><FONT COLOR="#777777">pk fk</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" PORT="dest_iso3">dest_iso3</TD><TD ALIGN="LEFT"><FONT COLOR="#333333">text</FONT></TD><TD ALIGN="LEFT" PORT="dest_iso3_e"><FONT COLOR="#777777">pk fk</FONT></TD></TR>
